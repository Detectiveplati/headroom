# Headroom Environment Variables

# Port for production Node.js server (Railway injects this automatically)
PORT=3000

# PostgreSQL connection URL (optional, falls back to local data/boards.json store)
# DATABASE_URL=postgresql://user:password@host:port/database

# Google Gemini API Key for AI Bank Statement & Receipt Extraction (PDF/Image)
# Get a free key at https://aistudio.google.com/
# Set this in your Railway project under "Variables" -> GEMINI_API_KEY
GEMINI_API_KEY=
