{
  "$schema": "https://json.schemastore.org/partial-claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm start)",
      "Bash(npm test)",
      "PowerShell(npm run dev)",
      "PowerShell(npm run build)",
      "PowerShell(npm run preview)",
      "PowerShell(npm start)",
      "PowerShell(npm test)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  }
}